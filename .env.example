# Server-only. Required by app/api/ask/route.ts so the Ask bar can answer (AGENTS.md §13).
# Never prefix this with NEXT_PUBLIC_ — that would ship the key to the browser.
# Copy this file to .env.local and paste a real key there; .env* is gitignored.
GEMINI_API_KEY=

# The Ask route's shared counter store (lib/ask/rate-limit.ts). Server-only, never NEXT_PUBLIC_.
# Absent, the counters live in the process and reset with it — fine locally, wrong on serverless,
# where every isolate starts at zero. Present but unreachable, the burst limiter degrades to
# in-process counting and the daily spend ceiling refuses rather than guessing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any random string. Client addresses are hashed before they reach the store; without a salt the
# hash of an IPv4 address is brute-forceable in seconds and is not a privacy control.
ASK_RATE_LIMIT_SALT=

# Optional. Overrides the global daily request ceiling for this environment; the code default is
# authoritative. A malformed value logs and falls back rather than disabling the ceiling.
ASK_DAILY_REQUEST_LIMIT=
